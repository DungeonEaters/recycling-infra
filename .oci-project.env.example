# Local OCI CLI profile and the non-secret identifiers used by project scripts.
# Copy this file to .oci-project.env and adjust only if the project names change.
# Never place private keys, passphrases, Customer Secret Keys, or GitHub tokens here.
OCI_CLI_PROFILE=DEFAULT
TEST_COMPARTMENT_NAME=cmp-reciclaje-test
TEST_INSTANCE_NAME=recycling-logistics-test
TEST_STATE_BUCKET=recycling-tfstate-test
TEST_STATE_PREFIX=bootstrap-test/
OCI_AVAILABILITY_DOMAIN=
ARM_CANDIDATE_UBUNTU_IMAGE_OCID=
